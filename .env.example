# Copiá este archivo a ".env" (sin el ".example") y completá con los datos
# de tu propio proyecto de Supabase: Project Settings → API.
#
# VITE_SUPABASE_ANON_KEY es la clave PÚBLICA ("anon"). Está pensada para
# quedar visible en el navegador de cualquier visitante — la seguridad real
# la da la Seguridad a Nivel de Fila (RLS) que configuramos en
# supabase_schema.sql, no el secreto de esta clave. Nunca uses acá la
# "service_role key" (esa sí es secreta y no debe ir al frontend).

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica
